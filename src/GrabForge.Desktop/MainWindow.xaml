<Window x:Class="GrabForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GrabForge" Icon="/Assets/grabforge.ico"
        Width="1280" Height="760" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#0C1220" BorderBrush="#243148" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,20,12,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,30">
          <Image Source="/Assets/grabforge.png" Width="34" Height="34" Margin="0,0,9,0"/>
          <TextBlock Text="GrabForge" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
          <TextBlock x:Name="VersionLabel" FontSize="12" Foreground="#8D9DB7"/>
        </StackPanel>
        <ListBox x:Name="Navigation" BorderThickness="0" Background="Transparent" SelectionChanged="Navigate" AutomationProperties.AutomationId="Navigation">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="NavBorder" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#302950"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#64539B"/><Setter TargetName="NavBorder" Property="BorderThickness" Value="1"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
          <ListBoxItem Content="ダウンロード"/>
          <ListBoxItem Content="キュー・履歴"/>
          <ListBoxItem Content="プリセット"/>
          <ListBoxItem Content="ツール・更新"/>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="20,12,20,10">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="保存先を開く" Click="OpenOutput" AutomationProperties.AutomationId="OpenOutput" Padding="10,5"/>
        <TextBlock x:Name="PageTitle" Text="ダウンロード" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="1" x:Name="PageHost" AutomationProperties.AutomationId="PageHost">
        <Grid x:Name="DownloadPage"/>
        <Grid x:Name="QueuePage" Visibility="Collapsed"/>
        <Grid x:Name="PresetsPage" Visibility="Collapsed"/>
        <Grid x:Name="ToolsPage" Visibility="Collapsed"/>
      </Grid>
      <DockPanel Grid.Row="2" Margin="0,8,0,0">
        <TextBlock x:Name="QueueSummary" DockPanel.Dock="Right" FontSize="11" Foreground="#8D9DB7" Margin="14,0,0,0"/>
        <TextBlock x:Name="Status" Text="準備完了" FontSize="11" Foreground="#9AACCA" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="Status"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
