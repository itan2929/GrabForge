<Window x:Class="GrabForge.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GrabForge — yt-dlp / FFmpeg GUI v0.1.0" Width="1280" Height="900" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <DockPanel Margin="20">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="GrabForge" FontSize="28" FontWeight="Bold"/><TextBlock Text="yt-dlp ＋ FFmpeg • Windows Native • Portable" Foreground="#96A7C1" Margin="0,4,0,0"/></StackPanel>
      <Button Grid.Column="1" Content="保存先を開く" Click="OpenOutput" AutomationProperties.AutomationId="OpenOutput"/>
    </Grid>
    <Border DockPanel.Dock="Bottom" Background="#192334" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="準備完了。未導入のツールは「ツール・更新」で準備できます。" AutomationProperties.AutomationId="Status"/></Border>
    <TabControl x:Name="Pages" AutomationProperties.AutomationId="MainTabs">
      <TabItem Header="ダウンロード"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DownloadPage" Margin="8"/></ScrollViewer></TabItem>
      <TabItem Header="キュー・履歴"><Grid x:Name="QueuePage"/></TabItem>
      <TabItem Header="プリセット"><StackPanel x:Name="PresetsPage" Margin="10"/></TabItem>
      <TabItem Header="ツール・更新"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ToolsPage" Margin="10"/></ScrollViewer></TabItem>
    </TabControl>
  </DockPanel>
</Window>
