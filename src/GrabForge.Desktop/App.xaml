<Application x:Class="GrabForge.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#101723"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#192334"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E5EDF8"/>
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Yu Gothic UI, Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Background" Value="#0F1826"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#3B4C66"/><Setter Property="CaretBrush" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="#384B71"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#667EAB"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="0,8,8,8"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="0,6,0,10"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#364860"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Padding" Value="7,5"/><Setter Property="MinWidth" Value="110"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="BorderBrush" Value="#364860"/><Setter Property="Padding" Value="10"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="16,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#E5EDF8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" Background="#1B293F" BorderBrush="#364860" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#51469B"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#9B8DFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabBorder" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#263750"/><Setter Property="Foreground" Value="#E5EDF8"/><Setter Property="Padding" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#142033"/><Setter Property="Foreground" Value="#E5EDF8"/><Setter Property="BorderBrush" Value="#364860"/></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="#142033"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#364860"/><Setter Property="Margin" Value="0,6,0,10"/></Style>
    <Style TargetType="ListViewItem"><Setter Property="Padding" Value="4,6"/></Style>
  </Application.Resources>
</Application>
